    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "resources": [
        "assets/chunk-DmAhMCYL.js"
      ],
      "use_dynamic_url": false
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "resources": [
        "assets/chunk-C4x3uLz6.js"
      ],
      "use_dynamic_url": false
    }
  ],
  "content_scripts": [
    {
      "js": [
        "assets/chunk-DmAhMCYL.js"
      ],
      "matches": [
        "https://gemini.google.com/*"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "js": [
        "assets/chunk-C4x3uLz6.js"
      ],
      "matches": [
        "https://chatgpt.com/*"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "js": [
        "assets/index.ts-loader-YcIjHYgS.js"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.deepseek.com/*",
        "https://gemini.google.com/*",
        "https://chat.qwen.ai/*"
      ],
      "run_at": "document_start"
    }
  ]
