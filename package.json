{
  "name": "chatgo",
  "version": "0.16.5",
  "private": true,
  "type": "module",
  "description": "ChatGo - 普适化 AI 聊天站点效率增强的 Chrome 扩展",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "preview": "vite preview",
    "test:runtime": "python3 tests/verify-runtime.py",
    "licenses:collect": "python3 tools/collect-licenses.py",
    "release:check": "python3 tools/release.py --check",
    "release:pack": "python3 tools/release.py",
    "test:release": "python3 -m unittest discover -s tests -p 'test_*.py'"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.6",
    "@lucide/vue": "^1.21.0",
    "@truto/turndown-plugin-gfm": "^1.0.2",
    "dompurify": "^3.4.11",
    "katex": "^0.16.22",
    "markdown-it": "^14.2.0",
    "pinia": "^2.2.6",
    "turndown": "^7.2.4",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@types/chrome": "^0.0.287",
    "@types/dompurify": "^3.2.0",
    "@types/katex": "^0.16.7",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.0.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vue-tsc": "^2.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "vue-demi"
    ]
  },
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
